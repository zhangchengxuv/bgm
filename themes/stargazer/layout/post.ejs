<article class="post-detail shell">
  <header>
    <p class="eyebrow"><span></span> ARTICLE · <%= date(page.date, 'YYYY.MM.DD') %></p>
    <h1><%= page.title %></h1>
    <% if (page.description || page.excerpt) { %>
      <p class="post-excerpt"><%= page.description || strip_html(page.excerpt) %></p>
    <% } %>
    <% if (page.tags && page.tags.length) { %>
      <div class="post-tags">
        <% page.tags.each(tag => { %>
          <span class="post-tag"># <%= tag.name %></span>
        <% }) %>
      </div>
    <% } %>
  </header>
  <div class="prose"><%- page.content %></div>
  <a class="back-link" href="<%- url_for('/archives/') %>">← 返回全部文章</a>
</article>
