<%
  const stats = site_stats();
  const recentPosts = page.posts ? page.posts.toArray().slice(0, 5) : [];
%>

<section class="bento-home shell">
  <!-- Row 1: Profile + Stats/Heatmap -->
  <div class="bento-grid">
    <article class="bento-card bento-profile reveal-1">
      <div class="profile-top">
        <div class="avatar-ring">
          <img class="profile-avatar" src="<%= stats.githubAvatar %>" alt="Zhang Chenxu" referrerpolicy="no-referrer" width="60" height="60">
        </div>
        <div class="profile-id">
          <div class="status-pill">
            <span class="status-dot"></span>
            <span>zhangchenxu.uk · ✦ 星海观测中</span>
          </div>
          <h1>你好，我是 <span class="aurora-text">Zhang Chenxu</span></h1>
        </div>
      </div>

      <p class="profile-bio">
        穿梭于代码与二次元星海之间——这里记录我的技术笔记与云端折腾，也与 Bangumi、GitHub 每日自动同步我追过的番、读过的书与开源足迹。
      </p>

      <div class="profile-actions">
        <a class="btn btn-aurora" href="<%- url_for('/collection/') %>">探索收藏馆 ✦</a>
        <a class="btn btn-glass" href="<%- url_for('/archives/') %>">阅读文章 →</a>
        <a class="btn btn-glass" href="<%= stats.githubUrl %>" target="_blank" rel="noopener">GitHub ↗</a>
        <a class="btn btn-glass" href="<%- url_for('/about/') %>">关于我</a>
      </div>
    </article>

    <div class="bento-side-col reveal-2">
      <div class="bento-mini-row">
        <a class="bento-card bento-stat" href="<%- url_for('/collection/') %>">
          <span class="stat-label">动画收藏</span>
          <strong class="stat-num aurora-num-a"><%= stats.anime %></strong>
          <span class="stat-sub">Bangumi 每日同步</span>
        </a>
        <a class="bento-card bento-stat" href="<%- url_for('/collection/#book') %>">
          <span class="stat-label">书籍 &amp; 游戏</span>
          <strong class="stat-num aurora-num-b"><%= stats.books + stats.games %></strong>
          <span class="stat-sub"><%= stats.books %> 本书 · <%= stats.games %> 款游戏</span>
        </a>
      </div>

      <a class="bento-card bento-heatmap" href="<%- url_for('/collection/#github') %>">
        <div class="card-head">
          <span class="card-title">GitHub 开源星图</span>
          <span class="card-meta mono"><%= stats.githubTotal %> 次贡献</span>
        </div>
        <div class="heatmap-grid" aria-label="GitHub 近期贡献热力图">
          <% stats.heatmapDays.forEach(day => { %>
            <span class="hm-cell lv-<%= day.level %>" title="<%= day.date %>: <%= day.count %> 次贡献"></span>
          <% }) %>
        </div>
      </a>
    </div>
  </div>

  <!-- Row 2: Latest Posts + Recent Bangumi Posters -->
  <div class="bento-grid bento-row-two">
    <section class="bento-card bento-posts reveal-3">
      <div class="card-head">
        <h2 class="card-title">最新文章</h2>
        <a class="card-link" href="<%- url_for('/archives/') %>">全部 <%= stats.posts %> 篇 →</a>
      </div>

      <% if (recentPosts.length) { %>
        <div class="article-list">
          <% recentPosts.forEach(post => { %>
            <a class="article-row" href="<%- url_for(post.path) %>">
              <div class="article-main">
                <h3><%= post.title %></h3>
                <p><%= post.description || (post.excerpt ? strip_html(post.excerpt) : strip_html(post.content).slice(0, 76) + '…') %></p>
              </div>
              <div class="article-aside">
                <time class="mono"><%= date(post.date, 'YYYY.MM.DD') %></time>
                <% if (post.categories && post.categories.length) { %>
                  <span class="cat-badge"><%= post.categories.toArray()[0].name %></span>
                <% } %>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted-empty">暂无文章。</p>
      <% } %>
    </section>

    <section class="bento-card bento-watching reveal-4">
      <div class="card-head">
        <h2 class="card-title">最近在看 / 看过</h2>
        <a class="card-link" href="<%- url_for('/collection/') %>">全部收藏 →</a>
      </div>

      <div class="anime-poster-list">
        <% stats.recentAnime.forEach(item => { %>
          <a class="anime-mini-item" href="<%- url_for('/subject/' + item.id + '/') %>">
            <div class="anime-cover-wrap">
              <img class="anime-mini-cover" src="<%= item.cover %>" alt="<%= item.title %>" loading="lazy" referrerpolicy="no-referrer">
            </div>
            <div class="anime-mini-info">
              <div class="anime-mini-top">
                <span class="anime-status"><%= item.status %></span>
                <span class="anime-score mono">★ <%= item.score %></span>
              </div>
              <h3><%= item.title %></h3>
              <span class="anime-sub"><%= item.type %></span>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
  </div>
</section>
