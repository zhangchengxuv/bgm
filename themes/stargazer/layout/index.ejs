<%
  const stats = site_stats();
  const steam = stats.steam || {};
  const recentIds = new Set((steam.recentGames || []).map(g => g.appid));
  const mergedSteam = [];
  const seenSteam = new Set();
  [...(steam.recentGames || []), ...(steam.topGames || [])].forEach(g => {
    if (!g || seenSteam.has(g.appid) || mergedSteam.length >= 6) return;
    seenSteam.add(g.appid);
    mergedSteam.push({ ...g, isRecent: recentIds.has(g.appid) });
  });
  const maxHours = Math.max(1, ...mergedSteam.map(g => Number(g.hoursForever || 0)));
  const previewPhotos = (stats.photos || []).slice(0, 6);
%>

<section class="bento-home shell">
  <!-- Row 1: Profile + Stats/Heatmap -->
  <div class="bento-grid">
    <article class="bento-card bento-profile reveal-1">
      <div class="profile-top">
        <div class="avatar-ring">
          <img class="profile-avatar" src="<%= stats.githubAvatar %>" alt="Zhang Chenxu" referrerpolicy="no-referrer" width="60" height="60">
        </div>
        <div class="profile-id">
          <div class="status-pill">
            <span class="status-dot"></span>
            <span>zhangchenxu.uk · ✦ 星海观测中</span>
          </div>
          <h1>你好，我是 <span class="aurora-text">Zhang Chenxu</span></h1>
        </div>
      </div>

      <p class="profile-bio">
        穿梭于代码、游戏与二次元星海之间——这里记录我的摄影作品，并与 Bangumi、Steam、GitHub 每日自动同步追番书单、游玩时长与开源足迹。
      </p>

      <div class="profile-actions">
        <a class="btn btn-aurora" href="<%- url_for('/collection/') %>">探索收藏馆 ✦</a>
        <a class="btn btn-glass" href="<%- url_for('/gallery/') %>">摄影画廊</a>
        <a class="btn btn-glass" href="<%= stats.githubUrl %>" target="_blank" rel="noopener">GitHub ↗</a>
        <a class="btn btn-glass" href="<%- url_for('/about/') %>">关于我</a>
      </div>
    </article>

    <div class="bento-side-col reveal-2">
      <div class="bento-mini-row">
        <a class="bento-card bento-stat" href="<%- url_for('/collection/') %>">
          <span class="stat-label">动画收藏</span>
          <strong class="stat-num aurora-num-a"><%= stats.anime %></strong>
          <span class="stat-sub">Bangumi 每日同步</span>
        </a>
        <a class="bento-card bento-stat" href="<%- url_for('/collection/#book') %>">
          <span class="stat-label">书籍 &amp; 游戏</span>
          <strong class="stat-num aurora-num-b"><%= stats.books + stats.games %></strong>
          <span class="stat-sub"><%= stats.books %> 本书 · <%= stats.games %> 款游戏</span>
        </a>
      </div>

      <a class="bento-card bento-heatmap" href="<%- url_for('/collection/#github') %>">
        <div class="card-head">
          <span class="card-title">GitHub 开源星图</span>
          <span class="card-meta mono"><%= stats.githubTotal %> 次贡献</span>
        </div>
        <div class="heatmap-grid" aria-label="GitHub 近期贡献热力图">
          <% stats.heatmapDays.forEach(day => { %>
            <span class="hm-cell lv-<%= day.level %>" title="<%= day.date %>: <%= day.count %> 次贡献"></span>
          <% }) %>
        </div>
      </a>
    </div>
  </div>

  <!-- Row 2: Steam Playtime (Top 6) + Recent Anime (6 Posters) -->
  <div class="bento-grid bento-row-three">
    <section class="bento-card bento-steam reveal-3">
      <div class="card-head">
        <h2 class="card-title">Steam 游戏时长</h2>
        <% if (steam.configured) { %>
          <span class="card-meta mono"><%= steam.totalHours %>h · <%= steam.gameCount %> 款</span>
        <% } else { %>
          <span class="card-meta mono">隐私安全同步</span>
        <% } %>
      </div>

      <% if (steam.configured && mergedSteam.length) { %>
        <div class="steam-summary-bar">
          <div class="steam-pill"><small>总时长</small><strong class="mono"><%= steam.totalHours %> h</strong></div>
          <div class="steam-pill"><small>近两周</small><strong class="mono"><%= steam.recentHours %> h</strong></div>
          <div class="steam-pill"><small>库内游戏</small><strong class="mono"><%= steam.gameCount %> 款</strong></div>
        </div>
        <div class="steam-game-list">
          <% mergedSteam.forEach(game => { %>
            <a class="steam-game-item" href="https://store.steampowered.com/app/<%= game.appid %>/" target="_blank" rel="noopener">
              <img class="steam-cover" src="<%= game.headerUrl %>" alt="<%= game.name %>" loading="lazy" referrerpolicy="no-referrer">
              <div class="steam-game-info">
                <div class="steam-game-top">
                  <h3><%= game.name %><% if (game.isRecent) { %><span class="recent-badge">近期</span><% } %></h3>
                  <span class="steam-hours mono"><%= game.hoursForever %> h</span>
                </div>
                <div class="steam-bar-track">
                  <div class="steam-bar-fill" style="width:<%= Math.min(100, Math.max(6, Math.round((game.hoursForever / maxHours) * 100))) %>%"></div>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bento-placeholder">
          <p>在 GitHub Secrets 中配置 <code>STEAM_API_KEY</code> 与 <code>STEAM_ID</code> 后自动同步总时长与常玩游戏榜单（不暴露个人主页）。</p>
        </div>
      <% } %>
    </section>

    <section class="bento-card bento-watching reveal-4">
      <div class="card-head">
        <h2 class="card-title">最近在看 / 看过</h2>
        <a class="card-link" href="<%- url_for('/collection/') %>">全部 <%= stats.anime %> 部 →</a>
      </div>

      <div class="anime-poster-list">
        <% stats.recentAnime.forEach(item => { %>
          <a class="anime-mini-item" href="<%- url_for('/subject/' + item.id + '/') %>">
            <div class="anime-cover-wrap">
              <img class="anime-mini-cover" src="<%= item.cover %>" alt="<%= item.title %>" loading="lazy" referrerpolicy="no-referrer">
            </div>
            <div class="anime-mini-info">
              <div class="anime-mini-top">
                <span class="anime-status"><%= item.status %></span>
                <span class="anime-score mono">★ <%= item.score %></span>
              </div>
              <h3><%= item.title %></h3>
              <span class="anime-sub"><%= item.type %></span>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
  </div>

  <!-- Row 3: QQ Music Vinyl Showcase -->
  <%
    const music = stats.music || {};
    const musicTracks = music.tracks || [];
    const leadTrack = musicTracks[0] || null;
  %>
  <% if (music.configured && musicTracks.length) { %>
    <section class="bento-card bento-music reveal-3" id="music-card">
      <div class="card-head">
        <div class="music-head-left">
          <h2 class="card-title">QQ 音乐 · <%= music.playlistName %></h2>
          <span class="music-count mono"><%= music.songCount %> 首红心</span>
        </div>
        <% if (musicTracks.length > 6) { %>
          <button type="button" class="music-shuffle-btn" id="music-shuffle-btn">换一批 ↻</button>
        <% } %>
      </div>

      <div class="music-layout">
        <div class="vinyl-showcase">
          <div class="vinyl-disc" id="vinyl-disc">
            <img id="vinyl-cover" src="<%= leadTrack.cover %>" alt="<%= leadTrack.name %>" referrerpolicy="no-referrer">
            <span class="vinyl-hole" aria-hidden="true"></span>
          </div>
          <div class="vinyl-meta">
            <span class="vinyl-tag">♫ RECENTLY LIKED</span>
            <strong id="vinyl-title"><%= leadTrack.name %></strong>
            <span id="vinyl-singer"><%= leadTrack.singer %></span>
          </div>
        </div>

        <div class="music-track-grid" id="music-track-grid">
          <% musicTracks.slice(0, 6).forEach((t, idx) => { %>
            <a class="music-track-item" href="<%= t.url %>" target="_blank" rel="noopener" data-track-idx="<%= idx %>">
              <img class="track-cover" src="<%= t.cover %>" alt="<%= t.name %>" loading="lazy" referrerpolicy="no-referrer">
              <div class="track-info">
                <h3><%= t.name %></h3>
                <span><%= t.singer %></span>
              </div>
              <span class="track-eq" aria-hidden="true"><i></i><i></i><i></i></span>
            </a>
          <% }) %>
        </div>
      </div>

      <script>
        (() => {
          const allTracks = <%- JSON.stringify(musicTracks) %>;
          const grid = document.getElementById('music-track-grid');
          const btn = document.getElementById('music-shuffle-btn');
          const vCover = document.getElementById('vinyl-cover');
          const vTitle = document.getElementById('vinyl-title');
          const vSinger = document.getElementById('vinyl-singer');
          let page = 0;

          const setVinyl = t => {
            if (!t) return;
            vCover.src = t.cover;
            vCover.alt = t.name;
            vTitle.textContent = t.name;
            vSinger.textContent = t.singer;
          };

          const bindHover = () => {
            grid?.querySelectorAll('.music-track-item').forEach(el => {
              el.addEventListener('mouseenter', () => {
                setVinyl(allTracks[Number(el.dataset.trackIdx)]);
              });
            });
          };
          bindHover();

          btn?.addEventListener('click', () => {
            const pageSize = 6;
            const totalPages = Math.ceil(allTracks.length / pageSize);
            page = (page + 1) % totalPages;
            const slice = allTracks.slice(page * pageSize, page * pageSize + pageSize);
            grid.innerHTML = slice.map((t, i) => {
              const idx = page * pageSize + i;
              const esc = s => String(s || '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
              return `<a class="music-track-item" href="${esc(t.url)}" target="_blank" rel="noopener" data-track-idx="${idx}">` +
                `<img class="track-cover" src="${esc(t.cover)}" alt="${esc(t.name)}" loading="lazy" referrerpolicy="no-referrer">` +
                `<div class="track-info"><h3>${esc(t.name)}</h3><span>${esc(t.singer)}</span></div>` +
                `<span class="track-eq" aria-hidden="true"><i></i><i></i><i></i></span></a>`;
            }).join('');
            setVinyl(slice[0]);
            bindHover();
          });
        })();
      </script>
    </section>
  <% } %>

  <!-- Row 4: Full-Width Photography Showcase -->
  <section class="bento-card bento-gallery bento-gallery-wide reveal-4">
    <div class="card-head">
      <h2 class="card-title">摄影作品精选</h2>
      <a class="card-link" href="<%- url_for('/gallery/') %>">查看全部 <%= stats.photos.length %> 张作品 →</a>
    </div>

    <% if (previewPhotos.length) { %>
      <div class="photo-preview-grid photo-preview-wide">
        <% previewPhotos.forEach(photo => { %>
          <a class="photo-preview-tile" href="<%- url_for('/gallery/') %>">
            <img src="<%= photo.src %>" alt="<%= photo.title %>" loading="lazy">
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <a class="bento-placeholder bento-placeholder-link" href="<%- url_for('/gallery/') %>">
        <span class="placeholder-spark">✦</span>
        <p>将照片放入本地 <code>source/photos/</code> 并推送即可自动展示。</p>
      </a>
    <% } %>
  </section>
</section>
