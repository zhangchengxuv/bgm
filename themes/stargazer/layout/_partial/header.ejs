<%
  const p = String(page.path || '');
  const isHome = p === 'index.html' || p === '';
  const isArchives = p.startsWith('archives/') || p.startsWith('posts/');
  const isCollection = p.startsWith('collection/') || p.startsWith('subject/');
  const isAbout = p.startsWith('about/');
%>
<header class="site-header">
  <div class="nav-wrap shell">
    <a class="brand" href="<%- url_for('/') %>" aria-label="返回首页">
      <svg class="brand-mark" viewBox="0 0 56 44" aria-hidden="true">
        <defs>
          <linearGradient id="worldline-gradient" x1="4" y1="36" x2="50" y2="8" gradientUnits="userSpaceOnUse">
            <stop stop-color="#60a5fa"/>
            <stop offset="1" stop-color="#c4b5fd"/>
          </linearGradient>
        </defs>
        <path class="brand-mark-ring" d="M40.8 7.8A18.2 18.2 0 1 0 45.9 33"/>
        <path class="brand-mark-line" d="M3.5 31.5C13.2 23.1 25.7 16.8 52.4 12.2"/>
        <path class="brand-mark-line brand-mark-line-alt" d="M6.2 10.5c11.1 2.3 22.1 10 43.6 25.3"/>
        <circle class="brand-mark-core" cx="28" cy="22" r="3.2"/>
      </svg>
      <span class="brand-name"><%= config.title %></span>
    </a>

    <nav class="main-nav" aria-label="主导航">
      <a href="<%- url_for('/') %>" class="<%= isHome ? 'active' : '' %>">首页</a>
      <a href="<%- url_for('/archives/') %>" class="<%= isArchives ? 'active' : '' %>">文章</a>
      <a href="<%- url_for('/collection/') %>" class="<%= isCollection ? 'active' : '' %>">收藏馆</a>
      <a href="<%- url_for('/about/') %>" class="<%= isAbout ? 'active' : '' %>">关于</a>
    </nav>

    <button class="theme-toggle" type="button" aria-label="切换浅色或深色主题" title="切换主题">
      <span class="sun" aria-hidden="true">☀</span>
      <span class="moon" aria-hidden="true">☾</span>
    </button>
  </div>
</header>
